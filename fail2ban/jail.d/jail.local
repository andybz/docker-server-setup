[DEFAULT]
# "bantime.increment" allows to use database for searching of previously banned ip's to increase a
# default ban time using special formula, default it is banTime * 1, 2, 4, 8, 16, 32...
bantime.increment = true

# "bantime.rndtime" is the max number of seconds using for mixing with random time
# to prevent "clever" botnets calculate exact time IP can be unbanned again:
bantime.rndtime = 2048

# for bantime=600 the multipliers are minutes and equal: 10 min, 30 min, 1 hour, 6 hours, 12 hour, 1 day, 2 day
bantime.multipliers = 1 3 6 36 72 144 288

# "bantime" is the number of seconds that a host is banned.
bantime  = 600

# A host is banned if it has generated "maxretry" during the last "findtime" seconds.
findtime = 60

# "maxretry" is the number of failures before a host get banned.
maxretry = 8

# use forward chain
chain = FORWARD

# Whitelisted IPs (separate with space)
# Includes local/private ranges and Cloudflare IPv4 proxy ranges to prevent
# accidentally banning Cloudflare and blocking all proxied traffic.
# Auto-maintained by ~/server/update-cloudflare-ips.sh
ignoreip = 127.0.0.1/8 192.168.1.0/24 172.16.0.0/12 172.58.135.33 172.58.135.42 50.222.230.226
           173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22
           141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20
           197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13
           104.24.0.0/14 172.64.0.0/13 131.0.72.0/22

[npm-docker]
# IPs that trigger too many 403 or 404
enabled = true
action = npm-firewall-block
filter = npm-docker
logpath = /var/log/npm/proxy-host-*_access.log

[wordpress-soft]
enabled  = true
filter   = wordpress-soft
logpath  = /var/log/wp-fail2ban.log
action = npm-firewall-block
findtime = 1200
maxretry = 8

[wordpress-hard]
enabled  = true
filter   = wordpress-hard
logpath  = /var/log/wp-fail2ban.log
action = npm-firewall-block
findtime = 1800
maxretry = 2
